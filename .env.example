# =============================================================================
# GENESIS configuration — copy this file to ".env" and fill in what you need.
# NEVER commit your real .env file. Every value below is optional: Genesis
# starts without any of them and degrades gracefully (offline mode).
# =============================================================================

# ---------------------------------------------------------------- Language model (the "AI brain")
# Genesis needs ONE key for open questions, explanations, writing and tool planning. Local commands
# ("open Downloads", "open VS Code", reminders…) work without it.
#
# QUICKEST SETUP (Hugging Face, free tier):  put your token on the HF_TOKEN line below and save.
#   Token: https://huggingface.co/settings/tokens → Create new token → "Fine-grained" →
#          tick "Make calls to Inference Providers". It starts with hf_
# Then test:  .\.venv\Scripts\python.exe -m genesis --check-llm   (or say "check your AI connection").
# Editing this file while Genesis runs is fine — it is re-read automatically, no restart needed.
#
# Windows notes: the file must be called exactly ".env" (not ".env.txt") and sit in the Genesis folder.
# Genesis also reads ".env.txt" and files saved by Notepad as "UTF-8 with BOM" or "Unicode", but prefer UTF-8.
# No quotes or spaces are needed around values:  HF_TOKEN=hf_abc123

# Provider: huggingface | openai (any OpenAI-compatible server) | anthropic | gemini | ollama | offline
# Leave blank to pick automatically from whichever key is set. (LLM_PROVIDER is accepted as the same setting.)
GENESIS_LLM_PROVIDER=
# Model name for the chosen provider (blank = the provider default below, e.g. HF_MODEL_ID).
LLM_MODEL=
# A generic key slot: used for LLM_PROVIDER (or detected from its prefix: hf_ / sk- / sk-ant- / AIza).
LLM_API_KEY=
# Custom API endpoint (OpenAI-compatible), e.g. http://localhost:1234/v1 for LM Studio. Blank = provider default.
LLM_BASE_URL=
# Generation settings (GENESIS_LLM_* names also work)
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024
# Seconds per request; failed requests are retried twice with exponential backoff.
LLM_TIMEOUT=45

# --- Hugging Face (default provider). HUGGINGFACE_TOKEN / HUGGING_FACE_HUB_TOKEN / HF_API_KEY also accepted.
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# --- OpenAI or any OpenAI-compatible server (LM Studio, vLLM, llama.cpp, OpenRouter …)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) — set LLM_MODEL to a Claude model name available to your account
ANTHROPIC_API_KEY=

# --- Google Gemini (GOOGLE_API_KEY also accepted) — set LLM_MODEL, e.g. a current Gemini flash model
GEMINI_API_KEY=

# --- Fully local LLM via Ollama (https://ollama.com):  ollama pull qwen2.5:7b-instruct  (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------- Knowledge base
# auto (sentence-transformers if installed, else local hashing) | sentence_transformers | huggingface | hashing
GENESIS_EMBEDDING_PROVIDER=auto
GENESIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------- Gmail / Google
# Create an OAuth client of type "Desktop app" in Google Cloud Console
# (APIs & Services → Credentials) and enable the Gmail API + Google Calendar API.
# Full walkthrough: docs/SETUP.md → "Gmail".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alternatively point to the downloaded client_secret_*.json instead of the two values above:
GOOGLE_CLIENT_SECRETS_FILE=

# ---------------------------------------------------------------- Voice
# Wake word engine: vosk (default, offline, free) | porcupine | none
GENESIS_WAKE_WORD_ENGINE=vosk
# Folder of the Vosk model (default: data/models/vosk-model-small-en-us-0.15,
# downloaded by: python scripts/download_models.py)
VOSK_MODEL_PATH=
# Optional Picovoice Porcupine (https://console.picovoice.ai): access key + a
# custom "Hey Genesis" keyword file (.ppn) trained for Windows.
PICOVOICE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATH=
# Speech-to-text: auto | faster_whisper | vosk | huggingface (huggingface sends audio to the cloud)
# 2.1: with auto and a Gemini key, what you say AFTER "Hey Genesis" is transcribed by Gemini (much more accurate), with the
# offline model as fallback. The wake word is always detected offline. faster_whisper = never send audio.
GENESIS_STT_ENGINE=auto
# 2.2: Gemini model used for transcription (default gemini-flash-latest, thinking off; falls back to your chat model)
GENESIS_STT_MODEL=
# base = multilingual (1.6: understands any language). base.en = English only. small = better for Indian languages (slower).
GENESIS_WHISPER_MODEL=base
HF_ASR_MODEL=openai/whisper-large-v3-turbo
# Text-to-speech: auto | piper (natural neural voice, offline) | sapi | pyttsx3 | none
# auto = Piper if a voice was downloaded (python scripts/download_models.py --voice), else the best female Windows voice.
# Voice gender / a specific voice / speaking rate: Settings → Voice.
GENESIS_TTS_ENGINE=auto
# Piper voice: a name in data/models/piper (default download: en_US-hfc_female-medium) or a path to a .onnx file
GENESIS_PIPER_VOICE=
# Microphone device index or name (blank = system default). List with: python scripts/list_audio_devices.py
GENESIS_AUDIO_DEVICE=

# ---------------------------------------------------------------- Runtime
# 1 = simulate shutdown/restart/sleep/lock (safe for demos & recordings)
GENESIS_SYSTEM_DRY_RUN=0
# Global hotkey to summon the assistant
GENESIS_HOTKEY=ctrl+alt+g
GENESIS_LOG_LEVEL=INFO
# Where data/ and logs/ live (blank = project folder when run from source)
GENESIS_HOME=
# Force the encrypted-file credential store instead of Windows Credential Manager: file
GENESIS_SECRET_BACKEND=

# ---------------------------------------------------------------- Screen understanding (optional, v1.1)
# Only used when you ask "what's on my screen?". Local OCR / UI Automation need:
#   pip install Pillow pytesseract uiautomation   (+ the Tesseract OCR program for pytesseract)
# If HF_TOKEN is set, a vision model can describe screenshots — Genesis asks before sending one online.
GENESIS_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# ---------------------------------------------------------------- 1.2 agent features (no new keys needed)
# • YouTube, windows, media keys, screenshots: work out of the box.
# • Google Calendar: uses the same Google OAuth client as Gmail. Enable the "Google Calendar API" in your Cloud project.
# • Coding agent: uses the LLM above (HF_TOKEN or Ollama). Python works immediately. For JavaScript/TypeScript install
#   Node.js 22.6+ (or `npm i -g tsx`), and for Java a JDK 11+. Projects go to ~/GenesisProjects (Settings → Coding agent).

# ---------------------------------------------------------------- 1.4 desktop agent (no new keys needed)
# • Computer control, WhatsApp, Colab and form filling use Microsoft Edge through Playwright (in requirements.txt) and the
#   Windows accessibility tree. WhatsApp and Google sign-ins happen in that browser window, by you — once.
# • Pictures: search uses Wikimedia Commons / Openverse (no key). Generating images uses HF_TOKEN (or OpenAI) with:
GENESIS_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# 2.1 image generation order (auto = Gemini if your account allows images -> HF/OpenAI -> free Pollinations service,
# which receives your prompt text). Unset = never use Pollinations. off = no image generation.
GENESIS_IMAGE_PROVIDER=auto
# Optional: a specific Gemini image model (default: tries gemini-2.5-flash-image, then newer ones). Needs billing.
GENESIS_GEMINI_IMAGE_MODEL=
# Free image generation (2.1.1): Cloudflare Workers AI, ~170 images a day on a free account. Setup_Images.bat fills these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: a Pollinations account key (sk_...) - https://enter.pollinations.ai
POLLINATIONS_API_KEY=
# 2.2.1: with GENESIS_IMAGE_PROVIDER=auto the free AI Horde network (https://aihorde.net) is the last resort - no account
# needed. A free AI Horde key (register on the site) gets you a faster place in its queue.
AIHORDE_API_KEY=
# 1 = run the automated browser hidden (servers/CI only)
GENESIS_BROWSER_HEADLESS=

# ---------------------------------------------------------------- 1.5 GitHub + Office
# GitHub: opening pages needs nothing. To list / create / delete YOUR repositories, create a token at
# github.com → Settings → Developer settings → Personal access tokens → Fine-grained → Repository access: All repositories
# → Permissions: Administration = Read and write (and Metadata = Read). Deleting a repository always asks you to type its
# name AND say yes. Never share this token.
GITHUB_TOKEN=
# Word / Excel / PowerPoint need no key. New files go to Documents\Genesis Documents.

# --- Google Colab (2.2) ---------------------------------------------------------------------------------------------
# chrome = your installed Google Chrome with a Genesis profile (sign in to your Google account there once; it stays
# signed in); edge = 1.x automated Edge window. Genesis controls that Chrome through a local port (127.0.0.1 only).
GENESIS_COLAB_BROWSER=chrome
GENESIS_CHROME_PATH=
GENESIS_CHROME_PORT=9333
